# منع تخزين قشرة التطبيق وملف الـ Service Worker في كاش الـ HTTP — كي تصل التحديثات فوراً
# (أصول البناء المُجزّأة index-XXXX.js تبقى مخزّنة للأبد عبر بصمتها في الاسم)
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
/sw-push.js
  Cache-Control: public, max-age=0, must-revalidate
